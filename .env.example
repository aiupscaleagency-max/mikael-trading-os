# ═══════════════════════════════════════════════════════════════════════════
#  MIKAEL TRADING OS — KONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# ── Claude (Anthropic) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Läge ──
MODE=paper
LIVE_TRADING_CONFIRMED=false
EXECUTION_MODE=auto

# ── Vilka motorer ska köras (komma-separerat) ──
# Tillgängliga: politician_copy, wheel_strategy, crypto_momentum
ENGINES=crypto_momentum

# ════════════════════════════════════════════════════════════════════
#  BROKERS
# ════════════════════════════════════════════════════════════════════

# ── Alpaca (Aktier + Optioner) ──
# Paper: https://paper-api.alpaca.markets
# Live:  https://api.alpaca.markets
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Blofin (Krypto-derivat, leverage) ──
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=
BLOFIN_BASE_URL=https://openapi.blofin.com

# ── Binance (Krypto spot, valfritt) ──
# Testnet: https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# ════════════════════════════════════════════════════════════════════
#  RISK-RAMAR + POSITION-SIZING (sätts av DIG)
# ════════════════════════════════════════════════════════════════════
# Hanna (Head Trader) defaultar till DEFAULT, anpassar mellan MIN och MAX
# baserat på conviction. Karin's vol-multiplier finjusterar.
DEFAULT_POSITION_USD=50
MIN_POSITION_USD=20
MAX_POSITION_USD=100
MAX_TOTAL_EXPOSURE_USD=500
MAX_DAILY_LOSS_USD=50
MAX_OPEN_POSITIONS=5

# ════════════════════════════════════════════════════════════════════
#  ENSEMBLE: 2-MODELL-OMRÖSTNING (second opinion)
# ════════════════════════════════════════════════════════════════════
# Varje trade som föreslås granskas av en ANDRA modell innan den går till
# risk managern. Bara om BÅDA säger "agree" läggs ordern. Grinden kan bara
# stoppa trades — risk managerns veto och position-sizing-låsen ovan är
# oförändrade och ligger kvar EFTER grinden.
#
# MODEL_A = modellen som föreslår (Head Trader, Claude).
# MODEL_B = den oberoende granskaren — GPT-6 Astra via OpenAI. Två modeller
#           från OLIKA leverantörer ger genuint skilda blinda fläckar.
MODEL_A=claude-sonnet-4-6
MODEL_B=gpt-6-astra
# anthropic | openai | openrouter — openrouter är förberedd men ej byggd.
MODEL_B_PROVIDER=openai

# OpenAI-nyckel för MODEL_B. EGEN nyckel — återanvänd ALDRIG ANTHROPIC_API_KEY.
# Hämta: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Valfritt: low | medium | high | xhigh. Skickas bara om satt.
# OBS: temperature/top_p skickas aldrig — de ger 400 på Astra.
OPENAI_REASONING_EFFORT=

# Om OpenAI-vägen inte går att använda (saknad nyckel, 401/403, slut kvot,
# okänd modell) loggas ett tydligt fel och DENNA Claude-modell röstar istället.
# Vi kör aldrig blint vidare utan andra-åsikt. Saknas även Claude-nyckeln blir
# det fail-closed "disagree" = ingen trade.
ENSEMBLE_FALLBACK_MODEL=claude-opus-4-6

ENSEMBLE_REQUIRE_AGREEMENT=true
# Transienta fel (timeout, 5xx, rate limit): false = fail-closed (ingen trade).
ENSEMBLE_FAIL_OPEN=false
# Ska grinden även gälla SELL/exits? false = nej, vi låser aldrig in oss i en
# position som vi försöker ta oss ur.
ENSEMBLE_GATE_EXITS=false
ENSEMBLE_TIMEOUT_MS=45000

# ════════════════════════════════════════════════════════════════════
#  LÄRLOOP: SIGNAL-JOURNAL + AUTOMATISK AVGÖRNING
# ════════════════════════════════════════════════════════════════════
# SHADOW-LÄGE. Journalen loggar varje riktat orderförslag (med BÅDA
# ensemble-rösterna) till data/learning.db och avgör det sedan mot faktisk
# prisdata. Den lägger ALDRIG order och påverkar aldrig ett orderbeslut.
# Nedröstade förslag journalförs också — det är så vi får veta om grinden
# räddade eller kostade pengar.
LEARNING_ENABLED=true

# Kostnadsantaganden vid avgörning. Medvetet konservativa — hellre en för
# pessimistisk statistik än en som lurar oss att systemet är bättre än det är.
LEARNING_FEE_BPS_CRYPTO=10
LEARNING_FEE_BPS_STOCK=1
LEARNING_FEE_BPS_FOREX=0
LEARNING_SLIPPAGE_BPS=5
LEARNING_FUNDING_BPS_PER_8H=1

# Likvidationsberäkning vid hävstång (CRYPTO_LEVERAGE). Underhållsmarginal
# och en buffert som krymper avståndet konservativt.
# OBS: formeln är en approximation och börsspecifik — den styr statistik,
# ingenting annat.
LEARNING_MMR=0.005
LEARNING_LIQ_BUFFER_PCT=0.002

# Hur ofta öppna signaler avgörs, och när en rad ges upp.
LEARNING_RESOLVE_INTERVAL_SECONDS=900
LEARNING_MAX_RESOLVE_ATTEMPTS=10

# Hur länge en signal får leva innan den räknas som utgången.
# 18 barer à 4h ≈ 3 dygn.
SIGNAL_HORIZON_BARS_CRYPTO=18
SIGNAL_HORIZON_BARS_STOCK=10
SIGNAL_HORIZON_BARS_FOREX=24

# ════════════════════════════════════════════════════════════════════
#  MOTOR C: CRYPTO MOMENTUM
# ════════════════════════════════════════════════════════════════════
# Top-15 likvida på Binance. Lägg till/ta bort efter behov.
# OBS: MATIC avlistades från Binance 2024-09-10 och ersattes av POL.
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,DOGEUSDT,DOTUSDT,LINKUSDT,POLUSDT,UNIUSDT,LTCUSDT,ATOMUSDT,NEARUSDT
CRYPTO_LEVERAGE=5
CRYPTO_TRAILING_STOP_PCT=2
CRYPTO_TP_STEPS=5,10,20

# ════════════════════════════════════════════════════════════════════
#  RESEARCH: PERPLEXITY (Lars)
# ════════════════════════════════════════════════════════════════════
# Lars körs först i varje session. Hämta nyckel: https://www.perplexity.ai/settings/api
# Pris: ~$0.005/anrop med Sonar Pro = $0.07/vecka.
PERPLEXITY_API_KEY=

# ════════════════════════════════════════════════════════════════════
#  FOREX: OANDA (för EUR/USD, GBP/USD osv)
# ════════════════════════════════════════════════════════════════════
# Skapa demo-konto: https://www.oanda.com/account/login
# Practice (demo): https://api-fxpractice.oanda.com
# Live:            https://api-fxtrade.oanda.com
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com
FOREX_SYMBOLS=EUR_USD,GBP_USD,USD_JPY,USD_CHF,AUD_USD,USD_CAD,EUR_GBP

# ════════════════════════════════════════════════════════════════════
#  MOTOR A: POLITICIAN COPY TRADING
# ════════════════════════════════════════════════════════════════════
STOCK_SYMBOLS=TSLA,NVDA,AAPL,MSFT

# ════════════════════════════════════════════════════════════════════
#  MOTOR B: WHEEL STRATEGY (Optioner)
# ════════════════════════════════════════════════════════════════════
WHEEL_UNDERLYINGS=TSLA,NVDA
# Delta ~0.3 = ~10% OTM, 70% sannolikhet att expira värdelös
WHEEL_PUT_DELTA=0.3
# Stäng kontraktet vid 50% vinst
WHEEL_PROFIT_TARGET_PCT=50

# ════════════════════════════════════════════════════════════════════
#  TIMING
# ════════════════════════════════════════════════════════════════════
# Agentens analysloop (sekunder). 300 = var 5:e minut.
LOOP_INTERVAL_SECONDS=300
# Position-scan för stop-loss-justering (sekunder). 900 = var 15:e min.
SCAN_INTERVAL_SECONDS=900
# Morning briefing-tid (UTC-timme). 7 = kl 09:00 svensk tid (CET).
BRIEFING_HOUR_UTC=7
