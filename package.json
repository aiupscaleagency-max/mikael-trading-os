{
  "name": "mikael-trading-os",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-asset AI trading agent: crypto (Blofin/Binance), stocks + options (Alpaca). Powered by Claude.",
  "type": "module",
  "scripts": {
    "agent": "tsx src/run.ts",
    "agent:once": "tsx src/run.ts --once",
    "propose": "tsx src/run.ts --propose",
    "account": "tsx src/scripts/account.ts",
    "kill": "tsx src/scripts/kill.ts",
    "ui": "DASHBOARD_PORT=3939 tsx src/run.ts --once",
    "demo": "tsx src/scripts/demo.ts",
    "build": "tsc --outDir dist > .tsc.log 2>&1; n=$(grep -c 'error TS' .tsc.log || true); [ \"$n\" -gt 0 ] && echo \"  ($n sedan tidigare typfel — npm run build:verbose för detaljer)\"; test -f dist/server/signalEngine.js",
    "verify": "npm run build && node scripts/verify-live.mjs",
    "test:signal": "npm run build && node scripts/test-signal-engine.mjs",
    "export:candles": "npm run build && node scripts/export-candles.mjs",
    "build:verbose": "tsc --outDir dist || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0"
  }
}
